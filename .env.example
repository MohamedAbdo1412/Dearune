# ── Dearune environment ────────────────────────────────────────────────
# Copy to .env and fill in. Only the VITE_ variables are used by the app.

# Supabase project (project settings → API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: the public origin used when building QR links, if the site is
# served from a different origin than the one the visitor's browser uses.
# Leave empty to use window.location.origin.
# VITE_PUBLIC_SITE_URL=https://dearune.example.com